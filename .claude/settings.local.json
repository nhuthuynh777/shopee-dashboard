{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "PowerShell(python -m pip install streamlit pandas plotly openpyxl numpy --upgrade)",
      "PowerShell(Get-Process *)",
      "PowerShell(netstat *)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:8501\" -TimeoutSec 5 -UseBasicParsing; Write-Host \"Status: $\\($r.StatusCode\\)\" } catch { Write-Host \"Error: $_\" })",
      "PowerShell(Start-Process \"http://127.0.0.1:8501\")",
      "PowerShell(python -m pip install matplotlib)",
      "PowerShell(Test-Path *)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(streamlit run *)",
      "Bash(pip show *)",
      "Bash(python -m streamlit run app.py)",
      "Skill(update-config)"
    ]
  }
}
